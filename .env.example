# Copy this to .env.local and fill in your project values
# Found at: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LLM provider selection
LLM_PROVIDER=anthropic
# Legacy alias supported by the provider factory
AI_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=1024

# Provider API keys (set the one that matches LLM_PROVIDER)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
